# Copie para .env e preencha. NUNCA versione o .env preenchido.
#
# Nenhuma destas variáveis pode ir para o front-end: no Vite, tudo que começa
# com VITE_ é embutido no bundle e fica visível para qualquer pessoa.

# Postgres próprio (local por enquanto, depois VPS da Hostinger).
DATABASE_URL=postgresql://mirava:SENHA@localhost:5432/mirava

# Assina a sessão de login da cliente (HS256). Gere com: openssl rand -hex 32
# Trocar este valor derruba TODAS as sessões ativas — só faça isso de propósito.
AUTH_SECRET=

# Mercado Pago → Suas integrações → Credenciais
# Comece pelas de TESTE. Só troque para produção depois do checklist do README.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_MODO=teste

# Front-end
SITE_URL=http://localhost:5173

# URL pública desta API + /webhook/mercadopago (preencha depois do deploy)
WEBHOOK_URL=

# Protege as rotas de tarefa agendada. Gere com: openssl rand -hex 32
CRON_SECRET=

# 3x sem juros custa ~R$1 por venda; 12x custaria ~R$5 (14% do lucro).
PARCELAS_SEM_JUROS=3
EMBALAGEM_CENTAVOS=500

# Onde as fotos de produto baixadas da Lilly ficam salvas. Padrão: ./uploads
# (relativo ao cwd do processo). Na VPS da Hostinger, aponte para um disco
# persistente — se for pra Cloud Run, isso precisa virar bucket em vez de disco.
UPLOADS_DIR=./uploads

# Avisos por e-mail (resend.com — plano gratuito cobre o começo).
RESEND_API_KEY=
EMAIL_REMETENTE=Mirava Joias <pedidos@seudominio.com.br>

# WhatsApp da loja, só dígitos com DDI. Vira o link wa.me nos avisos.
WHATSAPP_LOJA=5519998604004
