# Copie para .env e preencha. NUNCA versione o .env preenchido.
#
# Nenhuma destas variáveis pode ir para o front-end: no Vite, tudo que começa
# com VITE_ é embutido no bundle e fica visível para qualquer pessoa.

# Supabase → Settings → Database → Connection string (use o pooler, porta 6543)
DATABASE_URL=postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase → Settings → API → Project URL. Usado para buscar a chave pública
# (JWKS) que valida a assinatura ES256 dos tokens — este projeto não tem mais
# um SUPABASE_JWT_SECRET compartilhado para buscar no painel.
SUPABASE_URL=

# Mercado Pago → Suas integrações → Credenciais
# Comece pelas de TESTE. Só troque para produção depois do checklist do README.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_MODO=teste

# Front-end
SITE_URL=http://localhost:5173

# URL pública desta API + /webhook/mercadopago (preencha depois do deploy)
WEBHOOK_URL=

# Protege as rotas de tarefa agendada. Gere com: openssl rand -hex 32
CRON_SECRET=

# 3x sem juros custa ~R$1 por venda; 12x custaria ~R$5 (14% do lucro).
PARCELAS_SEM_JUROS=3
EMBALAGEM_CENTAVOS=500
