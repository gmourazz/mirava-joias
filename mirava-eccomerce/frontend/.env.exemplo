# Copie para .env.local e preencha.
#
# Estas duas são públicas por natureza: o Vite embute VITE_* no bundle e RLS
# é o que de fato protege os dados, não o sigilo desta chave.

# Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Settings → API → Project API keys → anon / publishable
VITE_SUPABASE_ANON_KEY=
